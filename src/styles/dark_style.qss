* {
    font-family: 'Segoe UI', 'Roboto', 'Noto Sans';
    font-size: 14px;
}

QMainWindow { background-color: #111827; color: #E5E7EB; }
QWidget#sidebarContainer { background-color: #1F2937; border-right: 1px solid #374151; }
QLabel#logoLabel { font-size: 20px; font-weight: bold; color: #3A7AFE; padding: 20px; }

QListWidget#sidebar { background-color: #1F2937; border: none; font-size: 15px; outline: 0; }
QListWidget#sidebar:focus { outline: none; }
QListWidget#sidebar::item { padding: 15px 20px; color: #D1D5DB; border-radius: 8px; margin: 5px 10px; outline: 0; }
QListWidget#sidebar::item:hover { background-color: #374151; color: #FFFFFF; }
QListWidget#sidebar::item:selected { background-color: #3A7AFE; color: white; font-weight: bold; }

QWidget#header { background-color: #1F2937; border-bottom: 1px solid #374151; padding: 10px 20px; }
QLabel#headerTitle { font-size: 22px; font-weight: bold; color: #E5E7EB; }
QLabel { color: #E5E7EB; }

QPushButton {
    padding: 8px 16px; border-radius: 4px; font-size: 14px; font-weight: bold;
    color: #FFFFFF; background-color: #374151; border: 1px solid #4B5563;
}
QPushButton:hover { background-color: #4B5563; }
QPushButton#btnPrimary { background-color: #3A7AFE; color: white; border: none; }
QPushButton#btnPrimary:hover { background-color: #2563EB; }
QPushButton#btnDanger { background-color: #EF4444; color: white; border: none; }
QPushButton#btnDanger:hover { background-color: #DC2626; }

QLineEdit, QComboBox, QDateEdit, QSpinBox {
    padding: 8px 12px; border: 1px solid #4B5563; border-radius: 4px;
    font-size: 14px; background-color: #374151; color: #FFFFFF;
}
QLineEdit:focus, QComboBox:focus, QDateEdit:focus { border: 1px solid #3A7AFE; }

QComboBox QAbstractItemView {
    background-color: #374151; color: #FFFFFF;
    selection-background-color: #3A7AFE; selection-color: white; border: 1px solid #4B5563;
}
QComboBox QAbstractItemView::item { color: #FFFFFF; padding: 8px; }
QComboBox QAbstractItemView::item:hover { background-color: rgba(255, 255, 255, 0.1); }

QTableView QLineEdit, QTableView QComboBox, QTableView QDateEdit {
    padding: 0px; margin: 0px; border: none; outline: none;
    background-color: #374151; color: #FFFFFF;
}

QTableView {
    background-color: #1F2937; border: 1px solid #374151; border-radius: 8px;
    gridline-color: #4B5563; font-size: 14px; color: #E5E7EB; outline: 0;
}
QTableView:focus { outline: 0; }
QTableView::item { color: #E5E7EB; border: none; outline: 0; }
QTableView::item:focus { outline: 0; border: none; }
QTableView::item:hover { background-color: rgba(58, 122, 254, 0.3); }
QTableView::item:selected { background-color: #3A7AFE; color: white; }

QHeaderView::section {
    background-color: #111827; color: #D1D5DB; padding: 10px; border: none;
    border-bottom: 1px solid #374151; border-right: 1px solid #374151; font-weight: bold;
}

QDialog { background-color: #1F2937; color: #E5E7EB; }
QDialog QLabel { color: #F3F4F6; font-weight: bold; }
QMessageBox { background-color: #1F2937; }
QMessageBox QLabel { color: #F3F4F6; }

QTableView QScrollBar:horizontal {
    border: none;
    background: #374151;
    height: 10px;
    margin: 0px 0px 0 0px;
    border-radius: 5px;
}
QTableView QScrollBar::handle:horizontal {
    background: #6B7280;
    min-width: 50px;
    border-radius: 5px;
}
QTableView QScrollBar::handle:horizontal:hover {
    background: #9CA3AF;
}
QTableView QScrollBar::add-line:horizontal, QTableView QScrollBar::sub-line:horizontal {
    border: none;
    background: none;
    width: 0px;
}

QTableView QScrollBar:vertical {
    border: none;
    background: #374151;
    width: 10px;
    margin: 0px 0px 0 0px;
    border-radius: 5px;
}
QTableView QScrollBar::handle:vertical {
    background: #6B7280;
    min-height: 50px;
    border-radius: 5px;
}
QTableView QScrollBar::handle:vertical:hover {
    background: #9CA3AF;
}
QTableView QScrollBar::add-line:vertical, QTableView QScrollBar::sub-line:vertical {
    border: none;
    background: none;
    height: 0px;
}
